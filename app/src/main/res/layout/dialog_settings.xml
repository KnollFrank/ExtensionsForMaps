<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Section: General -->
    <TextView
        android:id="@+id/tvGeneralLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/settings_section_general"
        android:textSize="16sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/checkBoxShowPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_show_preview" />

    <!-- Section: Optimization Method -->
    <TextView
        android:id="@+id/tvMethodLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:text="@string/settings_section_optimization_method"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Option: Straight Line -->
    <LinearLayout
        android:id="@+id/layoutHaversine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="8dp">

        <RadioButton
            android:id="@+id/rbHaversine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:text="@string/settings_method_haversine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:alpha="0.7"
            android:text="@string/settings_method_haversine_desc"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Option: Road Network -->
    <LinearLayout
        android:id="@+id/layoutOrs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="8dp">

        <RadioButton
            android:id="@+id/rbOrs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:text="@string/settings_method_ors" />

        <TextView
            android:id="@+id/tvOrsDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:alpha="0.7"
            android:text="@string/settings_method_ors_desc"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfigureOrs"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="8dp"
        android:text="⚙️"
        android:textSize="16sp" />

</LinearLayout>
