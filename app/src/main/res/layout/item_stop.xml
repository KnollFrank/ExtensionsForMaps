<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <!-- Obere Punkte-Linie (kommt vom vorherigen Item) -->
    <TextView
        android:id="@+id/tvDotsTop"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="⋮"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvIndexLetter"
        app:layout_constraintEnd_toEndOf="@+id/tvIndexLetter"
        app:layout_constraintStart_toStartOf="@+id/tvIndexLetter"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Container für den Buchstaben-Marker (A, B, C...) -->
    <!-- Vertikal zentriert zur Karte -->
    <TextView
        android:id="@+id/tvIndexLetter"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_stop_marker"
        android:elevation="2dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/cardDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardDetails"
        tools:text="A" />

    <!-- Untere Punkte-Linie (geht zum nächsten Item) -->
    <TextView
        android:id="@+id/tvDotsBottom"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:lineSpacingExtra="-4dp"
        android:text="⋮\n⋮\n⋮"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvIndexLetter"
        app:layout_constraintStart_toStartOf="@+id/tvIndexLetter"
        app:layout_constraintTop_toBottomOf="@+id/tvIndexLetter" />

    <!-- Die Karte mit den Stopp-Details -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvIndexLetter"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Adresse jetzt über die volle Breite -->
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Hauptstraße 1, 72108 Rottenburg" />

            <!-- Liefergruppe in die eigene Zeile gerückt -->
            <Spinner
                android:id="@+id/spinnerDeliveryGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAddress" />

            <LinearLayout
                android:id="@+id/llTimeWindow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spinnerDeliveryGroup">

                <TextView
                    android:id="@+id/tvWindowStartLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWindowStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:hint="nicht gesetzt"
                    android:padding="4dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWindowEndLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Ende:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWindowEnd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:hint="nicht gesetzt"
                    android:padding="4dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>