<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivBsPremiumIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/info_icon_desc"
        android:src="@drawable/ic_premium_star"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_premium_range" />

    <TextView
        android:id="@+id/tvBsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/subscription_bs_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBsPremiumIcon" />

    <TextView
        android:id="@+id/tvBsMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/subscription_bs_message"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBsTitle" />

    <TextView
        android:id="@+id/tvBsPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBsMessage"
        tools:text="1,00 €/Monat • Jederzeit kündbar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBsSubscribe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/color_premium_range"
        android:padding="16dp"
        android:text="@string/subscribe_button"
        android:textColor="?attr/colorOnPrimaryContainer"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvBsPrice" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBsDismiss"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/not_now"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBsSubscribe" />
</androidx.constraintlayout.widget.ConstraintLayout>
